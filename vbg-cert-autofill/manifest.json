{
  "manifest_version": 3,
  "name": "GramG Ninja",
  "version": "2.1.5",
  "key": "",
  "description": "Tools for the VB-G RAM G (MGNREGA) portal: certificate upload, Work Demand autofill from Excel, and reports to Excel/CSV.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "unlimitedStorage"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "options.html",
    "default_title": "GramG Ninja",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.dord.gov.in/vbgramg/work_entry.aspx*"
      ],
      "js": [
        "lib/pdf.min.js",
        "lib/pdf.worker.min.js",
        "lib/jspdf.umd.min.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.dord.gov.in/*"
      ],
      "js": [
        "dx-core.js",
        "wagebreakup.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.dord.gov.in/*"
      ],
      "js": [
        "pwreveal.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.dord.gov.in/*"
      ],
      "js": [
        "paste-enable.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.dord.gov.in/vbgramg/demand_new.aspx*"
      ],
      "js": [
        "demand-driver.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.dord.gov.in/vbgramg/demand_new.aspx*"
      ],
      "js": [
        "lib/xlsx.full.min.js",
        "demand-autofill.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/pdf.worker.min.js",
        "icons/icon48.png"
      ],
      "matches": [
        "https://*.dord.gov.in/*"
      ]
    }
  ]
}
